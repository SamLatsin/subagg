# Порт, на котором сервис слушает снаружи
SUBAGG_PORT=8080

# Пароль администратора для веб-интерфейса и админских ручек.
# Логин всегда admin. Обязательно поменяй.
SUBAGG_ADMIN_PASSWORD=change-me-please

# Каталог данных внутри контейнера
SUBAGG_DATA_DIR=/data

# Путь к mihomo внутри контейнера
SUBAGG_MIHOMO_BIN=/usr/local/bin/mihomo

# Интервал обновления подписок, минуты
SUBAGG_FETCH_INTERVAL_MIN=60

# Интервал проверки нод, минуты
SUBAGG_CHECK_INTERVAL_MIN=30

# Сколько нод проверять одновременно
SUBAGG_CHECK_CONCURRENCY=16

# Таймаут одной проверки, мс
SUBAGG_CHECK_TIMEOUT_MS=6000

# Сколько подряд неудачных проверок нужно, чтобы признать ноду мертвой
SUBAGG_DEAD_AFTER_FAILS=3

# Версия ядра mihomo для сборки образа
MIHOMO_VERSION=v1.19.31
TARGETARCH=amd64
